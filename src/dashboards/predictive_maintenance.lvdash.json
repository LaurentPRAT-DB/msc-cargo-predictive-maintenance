            "spec": {"version": 2, "widgetType": "filter-multi-select", "encodings": {"fields": [{"fieldName": "severity", "displayName": "Severity", "queryName": "ds_defect_data_severity"}]}, "frame": {"showTitle": true, "title": "Severity"}}
          },
          "position": {"x": 2, "y": 2, "width": 2, "height": 2}
