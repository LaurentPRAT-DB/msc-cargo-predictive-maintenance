{
  "datasets": [
    {
      "name": "defect_data",
      "displayName": "Defect Data",
      "queryLines": [
        "SELECT record_id, equipment_id, equipment_type, location, visit_date, defect_cluster_name, severity, days_to_failure, repair_duration_hrs, downtime_hrs, parts_replaced, quality_score FROM serverless_stable_3n0ihb_catalog.msc_cargo_predictive_maintenance.defect_features"
      ]
    },
    {
      "name": "monthly_trend",
      "displayName": "Monthly Trend",
      "queryLines": [
        "SELECT DATE_TRUNC('MONTH', visit_date) as month, count(*) as visits, round(avg(quality_score), 3) as avg_quality FROM serverless_stable_3n0ihb_catalog.msc_cargo_predictive_maintenance.defect_features GROUP BY DATE_TRUNC('MONTH', visit_date) ORDER BY month"
      ]
    },
    {
      "name": "equipment_agg",
      "displayName": "Equipment Aggregates",
      "queryLines": [
        "SELECT a.equipment_id, m.equipment_type, m.location, m.manufacturer, m.criticality, a.total_visits, a.distinct_defects, a.avg_quality_score, round(a.avg_repair_hrs, 1) as avg_repair_hrs, round(a.avg_downtime_hrs, 1) as avg_downtime_hrs, round(a.pct_high_severity * 100, 1) as pct_high_severity, a.last_visit_date FROM serverless_stable_3n0ihb_catalog.msc_cargo_predictive_maintenance.equipment_cluster_agg a JOIN serverless_stable_3n0ihb_catalog.msc_cargo_predictive_maintenance.equipment_master m ON a.equipment_id = m.equipment_id ORDER BY a.total_visits DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": ["## MSC Cargo — Predictive Maintenance Dashboard"]
            }
          },
          "position": {"x": 0, "y": 0, "width": 6, "height": 1}
        },
        {
          "widget": {
            "name": "subtitle",
            "multilineTextboxSpec": {
              "lines": ["Defect clustering analysis across 50 equipment units — 7 failure modes identified via K-means on text embeddings"]
            }
          },
          "position": {"x": 0, "y": 1, "width": 6, "height": 1}
        },
        {
          "widget": {
            "name": "filter-equipment-type",
            "queries": [{"name": "ds_defect_data_equipment_type", "query": {"datasetName": "defect_data", "fields": [{"name": "equipment_type", "expression": "`equipment_type`"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "filter-multi-select", "encodings": {"fields": [{"fieldName": "equipment_type", "displayName": "Equipment Type", "queryName": "ds_defect_data_equipment_type"}]}, "frame": {"showTitle": true, "title": "Equipment Type"}}
          },
          "position": {"x": 0, "y": 2, "width": 2, "height": 2}
        },
        {
          "widget": {
